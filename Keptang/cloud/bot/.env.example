# Copy this file to .env and fill it in (see README.md). Never share .env or put it in git.

# Discord Developer Portal → your app → General Information → Application ID
DISCORD_APPLICATION_ID=
# Discord Developer Portal → your app → Bot → Reset Token
DISCORD_TOKEN=

# Supabase → Project Settings → API (Data API) → Project URL
SUPABASE_URL=
# Supabase → Project Settings → API keys → service_role (secret). Only here, never in the app.
SUPABASE_SERVICE_KEY=
